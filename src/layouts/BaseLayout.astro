---
import '../styles/tokens.css';
import Seo from '../components/seo/Seo.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import StickyBar from '../components/ui/StickyBar.astro';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/menu". Used for canonical URL and nav highlighting. */
  path: string;
  image?: string;
  noindex?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161412" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
    />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={props.path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 12px; top: -60px; z-index: 100;
    background: var(--paper); color: var(--ink); padding: 12px 16px; font-weight: 600;
  }
  .skip:focus { top: 12px; }
</style>

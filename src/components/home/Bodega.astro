---
import PhotoSlot from '../ui/PhotoSlot.astro';
---
<section class="section">
  <div class="container">
    <div class="panel">
      <PhotoSlot alt="Shelves at Birdies Bodega" ratio="4 / 3" label="Photo: Birdies Bodega shelves" />
      <div class="copy">
        <span class="eyebrow">Inside the shop</span>
        <h2 class="display display-l">Birdies Bodega</h2>
        <p class="lede">Organic produce, Beehive and Manchego cheeses, French and local butters, hot sauces, oils and vinegars, so you can build the whole dinner in one stop.</p>
        <a href="/birdies-bodega">Shop the bodega →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .panel { background: var(--ink-2); border-radius: var(--radius); padding: clamp(20px, 4vw, 48px); display: grid; gap: 32px; align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  a { font-weight: 600; text-underline-offset: 4px; padding-block: 12px; }
  @media (min-width: 800px) { .panel { grid-template-columns: 1fr 1fr; gap: 56px; } }
</style>

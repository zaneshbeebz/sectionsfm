---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
const a = site.address;
---
<section class="section" aria-labelledby="visit-h">
  <div class="container wrap">
    <h2 class="display display-l" id="visit-h">Come by the counter</h2>
    <address>{a.street}<br />{a.city}, {a.region} {a.postalCode}</address>
    <p class="hours mono">{site.hoursSummary.map((h) => <span>{h}</span>)}</p>
    <div class="actions">
      <Button href={site.orderUrl} variant="primary" size="lg">Order for pickup</Button>
      <Button href={site.phoneHref} variant="outline" size="lg">Call the shop</Button>
      <a href="/visit">Hours &amp; FAQ →</a>
    </div>
  </div>
</section>

<style>
  .section { border-top: 1px solid var(--line-dark); }
  .wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  address { font-style: normal; font-size: 18px; color: var(--soft-on-dark); }
  .hours { display: flex; flex-direction: column; margin: 0; font-size: 14px; color: var(--muted-on-dark); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .actions a:not(.btn) { font-weight: 600; text-underline-offset: 4px; padding-block: 12px; }
</style>

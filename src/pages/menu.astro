---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import MenuSection from '../components/category/MenuSection.astro';
import menu from '../content/menu.json';
import { site } from '../data/site';
import type { Menu } from '../data/types';

const data = menu as Menu;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `${site.name} Menu`,
  url: `${site.url}/menu`,
  inLanguage: 'en',
  hasMenuSection: data.categories.map((c) => ({
    '@type': 'MenuSection',
    name: c.name,
    hasMenuItem: c.items.map((i) => ({
      '@type': 'MenuItem',
      name: i.name,
      ...(i.description ? { description: i.description } : {}),
      offers: { '@type': 'Offer', price: i.price.toFixed(2), priceCurrency: 'USD' },
    })),
  })),
};
---
<BaseLayout
  title="Menu | Sections Fine Meats, Costa Mesa"
  description="Sandwiches, kitchen plates, sides, drinks and pantry goods from Sections Fine Meats in Costa Mesa. Order pickup online; fresh cuts are at the counter."
  path="/menu"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <div class="on-paper">
    <div class="container section">
      <header class="top">
        <span class="eyebrow">Kitchen · Counter · Bodega</span>
        <h1 class="display display-xl">The Menu</h1>
        <p class="lede">Sandwiches built on our own smoked and cured meats, plates from the kitchen, and pantry staples to take home.</p>
        <div class="actions"><Button href={site.orderUrl}>Order for pickup</Button></div>
        <p class="counter-note">
          Fresh cuts are not on the online menu. They are cut to order at the counter. See our
          <a href="/dry-aged-steak-costa-mesa">dry-aged steaks</a>.
        </p>
        <nav aria-label="Menu categories">
          <ul class="pills">
            {data.categories.map((c) => <li><a href={`#${c.id}`}>{c.name}</a></li>)}
          </ul>
        </nav>
      </header>

      <div class="sections">
        {data.categories.map((c) => <MenuSection category={c} />)}
      </div>

      <p class="fee mono">A 2% surcharge applies to credit card payments.</p>
      <!-- CONFIRM: Veggie sandwich at $8.00 looks low vs. other sandwiches; verify price with owner. -->
      <!-- CONFIRM: Several sandwiches (Cuban, Italian, BBQ Burger, Fig & Brie Panini) have no description in the source data. -->
    </div>
  </div>
</BaseLayout>

<style>
  .top { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 56px; }
  h1 { font-size: clamp(56px, 10vw, 120px); }
  .counter-note { margin: 0; max-width: 36rem; color: var(--soft-on-paper); }
  .counter-note a { font-weight: 600; text-underline-offset: 4px; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px;
    border: 1.5px solid var(--ink); border-radius: 999px; text-decoration: none;
    font-weight: 600; font-size: 15px;
  }
  .pills a:hover { background: var(--ink); color: var(--paper); }
  .sections { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px); }
  .fee { margin: 56px 0 0; padding-top: 20px; border-top: 1px solid var(--line-paper); font-size: 14px; color: var(--muted-on-paper); }
</style>
